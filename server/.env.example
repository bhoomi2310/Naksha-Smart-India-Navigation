# Server Configuration
PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OpenRouteService API Key (REQUIRED for real routing data)
# ⚠️ Route requests will fail without this key!
# Get your FREE API key (2,000 requests/day):
# 1. Visit: https://openrouteservice.org/dev/#/signup
# 2. Sign up (free, no credit card)
# 3. Get your API key from dashboard
# 4. Paste it below (remove the # and add your key)
# OPENROUTESERVICE_API_KEY=your-api-key-here
OPENROUTESERVICE_API_KEY=
